{
  "friendly_name": "Mullvad Browser",
  "image_src": "mullvad-browser.png",
  "description": "Mullvad Browser is a privacy-focused web browser developed in a collaboration between Mullvad VPN and the Tor Project.",
  "name": "lscr.io/linuxserver/mullvad-browser:latest",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "https://ghcr.io/",
  "categories": [
    "Browser"
  ],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "run_config": {
    "security_opt": [
      "seccomp=unconfined"
    ],
    "entrypoint": [
      "/kasminit"
    ],
    "user": 1000,
    "environment": {
      "HOME": "/home/kasm-user"
    }
  },
  "exec_config": {},
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    "1.13.x",
    "1.14.x",
    "1.15.x",
    "1.16.x"
  ],
  "uncompressed_size_mb": 2220
}